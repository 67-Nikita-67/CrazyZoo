<UserControl x:Class="CrazyZoo.WPF.Views.SimulationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F1F5F9">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Animal CPU Simulation"
                       FontSize="25"
                       FontWeight="Bold"/>

            <TextBlock
                Text="Compare sequential and parallel calculations."
                Foreground="Gray"
                Margin="0,5,0,0"/>
        </StackPanel>

        <GroupBox Grid.Row="1"
                  Header="Simulation Settings"
                  Margin="0,0,0,12">

            <StackPanel Margin="12">

                <TextBlock Text="Select at least 3 animals:"
                           FontWeight="Bold"/>

                <ListBox x:Name="AnimalList"
                         Height="130"
                         Margin="0,8,0,8">

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding Name}"
                                      IsChecked="{Binding IsSelected,
                                          Mode=TwoWay}"
                                      Margin="5"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Button Content="Refresh Animals"
                        Click="Refresh_Click"
                        HorizontalAlignment="Left"
                        Padding="12,6"
                        Margin="0,0,0,12"/>

                <TextBlock Text="Iterations per animal:"
                           FontWeight="Bold"/>

                <TextBox x:Name="IterationsBox"
                         Text="10000000"
                         Width="190"
                         HorizontalAlignment="Left"
                         Padding="7"
                         Margin="0,5,0,12"/>

                <CheckBox x:Name="ErrorCheckBox"
                          Content="Test error on first animal"
                          Margin="0,0,0,12"/>

                <WrapPanel>
                    <Button x:Name="SequentialButton"
                            Content="Sequential"
                            Click="Sequential_Click"
                            Background="#BFDBFE"
                            Padding="12,8"
                            Margin="3"/>

                    <Button x:Name="ParallelButton"
                            Content="Parallel"
                            Click="Parallel_Click"
                            Background="#BBF7D0"
                            Padding="12,8"
                            Margin="3"/>

                    <Button x:Name="CompareButton"
                            Content="Compare Both"
                            Click="Compare_Click"
                            Background="#FDE68A"
                            Padding="12,8"
                            Margin="3"/>

                    <Button x:Name="CancelButton"
                            Content="Cancel"
                            Click="Cancel_Click"
                            Background="#FECACA"
                            IsEnabled="False"
                            Padding="12,8"
                            Margin="3"/>
                </WrapPanel>

                <TextBlock x:Name="StatusText"
                           Text="Ready."
                           FontWeight="SemiBold"
                           Margin="4,12,0,0"/>
            </StackPanel>
        </GroupBox>

        <GroupBox Grid.Row="2"
                  Header="Simulation Report">

            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ListBox x:Name="ReportList"
                         Grid.Row="0"
                         FontSize="13"/>

                <TextBlock x:Name="TotalTimeText"
                           Grid.Row="1"
                           Text="No calculations yet."
                           FontWeight="Bold"
                           TextWrapping="Wrap"
                           Margin="5,12,5,5"/>
            </Grid>
        </GroupBox>
    </Grid>
</UserControl>
