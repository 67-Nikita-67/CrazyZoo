<Window x:Class="CrazyZoo.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Crazy Zoo"
        Height="760"
        Width="1100"
        MinHeight="650"
        MinWidth="850"
        WindowStartupLocation="CenterScreen"
        Background="#F1F5F9">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <DataTemplate x:Key="AnimalTemplate">
            <StackPanel Margin="5">
                <TextBlock Text="{Binding DisplayName}"
                           FontSize="16"
                           FontWeight="SemiBold"/>
                <TextBlock FontSize="12"
                           Foreground="Gray">
                    <Run Text="Energy: "/>
                    <Run Text="{Binding Energy, Mode=OneWay}"/>
                    <Run Text=" | Happiness: "/>
                    <Run Text="{Binding Happiness, Mode=OneWay}"/>
                </TextBlock>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <DockPanel Margin="18">

        <Border DockPanel.Dock="Top"
                Background="#1E293B"
                CornerRadius="12"
                Padding="20"
                Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="CRAZY ZOO"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="White"/>
                <TextBlock Text="Welcome to the craziest zoo in the world!"
                           FontSize="14"
                           Foreground="#CBD5E1"/>
            </StackPanel>
        </Border>

        <TabControl>

            <TabItem Header="Zoo World">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="190"/>
                    </Grid.RowDefinitions>

                    <GroupBox Header="Our Animals"
                              Grid.Column="0"
                              Grid.Row="0"
                              Margin="5">
                        <DockPanel Margin="8">

                            <StackPanel DockPanel.Dock="Bottom"
                                        Margin="0,10,0,0">

                                <ComboBox SelectedValuePath="Content"
                                          SelectedValue="{Binding SelectedSpecies, Mode=TwoWay}"
                                          SelectedIndex="0"
                                          Margin="4">
                                    <ComboBoxItem Content="Monkey"/>
                                    <ComboBoxItem Content="Penguin"/>
                                    <ComboBoxItem Content="Lion"/>
                                    <ComboBoxItem Content="Parrot"/>
                                    <ComboBoxItem Content="Elephant"/>
                                </ComboBox>

                                <TextBox Text="{Binding NewAnimalName, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="4"
                                         Padding="8"
                                         MaxLength="20"
                                         ToolTip="Enter animal name"/>

                                <Button Content="Add Animal"
                                        Command="{Binding AddCommand}"/>

                                <Button Content="Remove Animal"
                                        Command="{Binding RemoveCommand}"
                                        Background="#FECACA"/>

                            </StackPanel>

                            <ListBox x:Name="AnimalList"
                                     ItemsSource="{Binding Animals}"
                                     SelectedItem="{Binding SelectedAnimal, Mode=TwoWay}"
                                     ItemTemplate="{StaticResource AnimalTemplate}"/>

                        </DockPanel>
                    </GroupBox>

                    <GroupBox Header="Selected Animal"
                              Grid.Column="1"
                              Grid.Row="0"
                              Margin="5">

                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="15"
                                        DataContext="{Binding SelectedAnimal}">

                                <TextBlock Text="{Binding DisplayName, TargetNullValue=Select an animal}"
                                           FontSize="25"
                                           FontWeight="Bold"
                                           Margin="0,0,0,20"/>

                                <TextBlock Text="Energy"
                                           FontWeight="Bold"/>

                                <ProgressBar Value="{Binding Energy, Mode=OneWay}"
                                             Maximum="100"
                                             Height="22"
                                             Margin="0,5,0,5"/>

                                <TextBlock Text="{Binding Energy, StringFormat='{}{0}/100'}"
                                           HorizontalAlignment="Right"/>

                                <TextBlock Text="Happiness"
                                           FontWeight="Bold"
                                           Margin="0,12,0,0"/>

                                <ProgressBar Value="{Binding Happiness, Mode=OneWay}"
                                             Maximum="100"
                                             Height="22"
                                             Margin="0,5,0,5"/>

                                <TextBlock Text="{Binding Happiness, StringFormat='{}{0}/100'}"
                                           HorizontalAlignment="Right"/>

                                <TextBlock Text="Actions"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Margin="0,20,0,8"/>

                                <WrapPanel>

                                    <Button Content="Eat"
                                            Command="{Binding DataContext.EatCommand,
                                                RelativeSource={RelativeSource AncestorType=Window}}"/>

                                    <Button Content="Rest"
                                            Command="{Binding DataContext.RestCommand,
                                                RelativeSource={RelativeSource AncestorType=Window}}"/>

                                    <Button Content="Sound"
                                            Command="{Binding DataContext.SoundCommand,
                                                RelativeSource={RelativeSource AncestorType=Window}}"/>

                                    <Button Content="Swim"
                                            Command="{Binding DataContext.SwimCommand,
                                                RelativeSource={RelativeSource AncestorType=Window}}"/>

                                    <Button Content="Climb"
                                            Command="{Binding DataContext.ClimbCommand,
                                                RelativeSource={RelativeSource AncestorType=Window}}"/>

                                    <Button Content="Fly"
                                            Command="{Binding DataContext.FlyCommand,
                                                RelativeSource={RelativeSource AncestorType=Window}}"/>

                                    <Button Content="Talk"
                                            Command="{Binding DataContext.TalkCommand,
                                                RelativeSource={RelativeSource AncestorType=Window}}"/>

                                    <Button Content="Crazy Action!"
                                            Background="#FACC15"
                                            Command="{Binding DataContext.CrazyCommand,
                                                RelativeSource={RelativeSource AncestorType=Window}}"/>

                                </WrapPanel>

                                <Expander Header="Rename Animal"
                                          Margin="0,15,0,0"
                                          Padding="5">
                                    <StackPanel Orientation="Horizontal">

                                        <TextBox Width="180"
                                                 MaxLength="20"
                                                 Padding="7"
                                                 Text="{Binding DataContext.RenameText,
                                                     RelativeSource={RelativeSource AncestorType=Window},
                                                     UpdateSourceTrigger=PropertyChanged}"/>

                                        <Button Content="Rename"
                                                Command="{Binding DataContext.RenameCommand,
                                                    RelativeSource={RelativeSource AncestorType=Window}}"/>

                                    </StackPanel>
                                </Expander>

                            </StackPanel>
                        </ScrollViewer>
                    </GroupBox>

                    <GroupBox Header="Event Log"
                              Grid.Column="0"
                              Grid.ColumnSpan="2"
                              Grid.Row="1"
                              Margin="5">

                        <DockPanel Margin="8">

                            <Button Content="Clear Log"
                                    DockPanel.Dock="Bottom"
                                    HorizontalAlignment="Right"
                                    Command="{Binding ClearLogCommand}"/>

                            <ListBox x:Name="LogList"
                                     ItemsSource="{Binding Logs}"/>

                        </DockPanel>
                    </GroupBox>

                </Grid>
            </TabItem>

            <TabItem Header="LINQ Explorer">
                <Grid Margin="20">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">

                        <TextBlock Text="LINQ Animal Explorer"
                       FontSize="26"
                       FontWeight="Bold"
                       Margin="0,0,0,10"/>

                        <TextBlock Text="Search, sort and group your animals using LINQ!"
                       FontSize="14"
                       Foreground="Gray"
                       Margin="0,0,0,20"/>

                        <GroupBox Header="Search Animals"
                      Margin="0,0,0,15">

                            <StackPanel Margin="10">

                                <TextBlock Text="Enter animal name:"
                               Margin="0,0,0,5"/>

                                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Padding="10"
                             FontSize="15"
                             Margin="0,0,0,10"/>

                                <Button Content="Search by Name"
                            Command="{Binding SearchCommand}"
                            Background="#BFDBFE"
                            HorizontalAlignment="Left"/>

                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Sort and Group"
                      Margin="0,0,0,15">

                            <StackPanel Margin="10">

                                <WrapPanel>

                                    <Button Content="Sort by Energy"
                                Command="{Binding SortCommand}"
                                Background="#BBF7D0"/>

                                    <Button Content="Group by Species"
                                Command="{Binding GroupCommand}"
                                Background="#FDE68A"/>

                                </WrapPanel>

                            </StackPanel>
                        </GroupBox>

                    </StackPanel>

                    <GroupBox Header="LINQ Results"
                  Grid.Row="1"
                  Margin="0,10,0,0">

                        <ListBox ItemsSource="{Binding LinqResults}"
                     FontSize="15"
                     Padding="10"
                     Background="White"/>

                    </GroupBox>

                </Grid>
            </TabItem>

            <TabItem Header="About">
                <StackPanel Margin="25">

                    <TextBlock Text="Crazy Zoo"
                               FontSize="28"
                               FontWeight="Bold"/>

                    <TextBlock Text="C# OOP + WPF school project"
                               FontSize="17"
                               Margin="0,10,0,20"/>

                    <TextBlock Text="This application demonstrates:"
                               FontWeight="Bold"/>

                    <TextBlock Margin="10"
                               TextWrapping="Wrap"
                               Text="Abstract classes, inheritance, interfaces, polymorphism, generic repositories, events, LINQ, MVVM, ICommand, ObservableCollection, DataTemplate, ProgressBar, Expander and TabControl."/>

                    <TextBlock Text="Every animal has its own CrazyAction!"
                               FontWeight="Bold"
                               Margin="0,20,0,0"/>

                </StackPanel>
            </TabItem>

        </TabControl>
    </DockPanel>
</Window>
